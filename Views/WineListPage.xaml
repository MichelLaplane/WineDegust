<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WineDegust.ViewModels"
             xmlns:models="clr-namespace:WineDegust.Models"
             x:Class="WineDegust.Views.WineListPage"
             Title="{Binding Title}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ajouter" Command="{Binding AddWineCommand}" />
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="*,Auto" Padding="10">
        <CollectionView ItemsSource="{Binding Wines}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <StackLayout Padding="20" VerticalOptions="Center">
                    <Label Text="Aucun vin"
                           FontSize="20"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Ajoutez votre premier vin pour commencer"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </StackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Wine">
                    <Frame Margin="5" Padding="10" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WineListViewModel}}, Path=SelectWineCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <!-- Photo -->
                            <Frame Grid.RowSpan="4" WidthRequest="70" HeightRequest="100" Padding="0" CornerRadius="5" IsClippedToBounds="True">
                                <Image Source="{Binding PhotoPath, TargetNullValue='dotnet_bot.png'}"
                                       Aspect="AspectFill" />
                            </Frame>
                            
                            <!-- Wine Info -->
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Producer}" FontSize="14" TextColor="Gray" />
                            <Label Grid.Column="1" Grid.Row="2" FontSize="12" TextColor="DarkGray">
                                <Label.Text>
                                    <MultiBinding StringFormat="Note de dégustation: {0}/20">
                                        <Binding Path="TastingNote" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Grid.Column="1" Grid.Row="3" FontSize="12" TextColor="DarkGray">
                                <Label.Text>
                                    <MultiBinding StringFormat="Note de goût: {0}/20">
                                        <Binding Path="TasteRating" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            
                            <!-- Delete Button -->
                            <Button Grid.Column="2" Grid.RowSpan="4" 
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WineListViewModel}}, Path=DeleteWineCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Start" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
